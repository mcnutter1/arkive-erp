{
  "name": "arkive-operations-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Arkive Operations Platform monorepo",
  "packageManager": "pnpm@9.12.3",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "turbo run format",
    "db:generate": "pnpm --filter @arkive/api prisma:generate",
    "db:migrate": "pnpm --filter @arkive/api prisma:migrate",
    "db:seed": "pnpm --filter @arkive/api prisma:seed"
  },
  "devDependencies": {
    "turbo": "^2.1.1",
    "typescript": "^5.6.2"
  }
}
