# ------------------------------
# Global
# ------------------------------
NODE_ENV=development
LOG_LEVEL=info
APP_BASE_URL=http://localhost
APP_TIMEZONE=UTC
COMPOSE_PROJECT_NAME=arkive-erp
ARKIVE_DATA_ROOT=/opt/arkive
ARKIVE_GIT_REPO_URL=https://github.com/mcnutter1/arkive-erp.git

# ------------------------------
# Database
# ------------------------------
POSTGRES_DB=arkive
POSTGRES_USER=arkive
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://arkive:change-me@postgres:5432/arkive?schema=public

# ------------------------------
# Redis
# ------------------------------
REDIS_URL=redis://redis:6379

# ------------------------------
# Object storage (S3-compatible)
# ------------------------------
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=arkive-documents
S3_ACCESS_KEY_ID=change-me
S3_SECRET_ACCESS_KEY=change-me
S3_FORCE_PATH_STYLE=true

# ------------------------------
# MinIO console
# ------------------------------
MINIO_ROOT_USER=change-me
MINIO_ROOT_PASSWORD=change-me

# ------------------------------
# API
# ------------------------------
API_PORT=4000
API_CORS_ORIGIN=http://localhost:3000
JWT_ISSUER=arkive-ops
JWT_AUDIENCE=arkive-ops

# ------------------------------
# Web
# ------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost/api/v1
INTERNAL_API_BASE_URL=http://api:4000/api/v1
NEXT_PUBLIC_APP_NAME="Arkive Operations Platform"

# ------------------------------
# Microsoft Entra / OIDC (placeholder values)
# ------------------------------
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_SECRET=replace-via-secret-store
ENTRA_REDIRECT_URI=http://localhost/api/v1/auth/callback
ENTRA_ALLOWED_DOMAINS=arkive.example
ENTRA_ALLOWED_TENANTS=00000000-0000-0000-0000-000000000000
AUTH_JIT_ENABLED=false
SESSION_TTL_HOURS=8
AUTH_LOCAL_LOGIN_ENABLED=true
AUTH_LOCAL_ADMIN_USERNAME=admin
AUTH_LOCAL_ADMIN_PASSWORD=admin
AUTH_LOCAL_ADMIN_EMAIL=admin@local.arkive

# ------------------------------
# Worker / queues
# ------------------------------
QUEUE_PREFIX=arkive
M365_DRY_RUN=true

# ------------------------------
# Security
# ------------------------------
COOKIE_SECRET=change-me
ENCRYPTION_KEY=32-byte-key-placeholder
REQUEST_RATE_LIMIT_PER_MIN=120

# ------------------------------
# Reverse proxy / TLS
# ------------------------------
# Must be a public DNS hostname for Let's Encrypt, e.g. erp.arkive.com
PUBLIC_DOMAIN=localhost
# Email used by ACME/Let's Encrypt for expiry and account notices
ACME_EMAIL=ops@example.com
