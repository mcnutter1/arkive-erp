{
  email {$ACME_EMAIL}
}

{$PUBLIC_DOMAIN} {
  encode gzip zstd

  @api path /api/* /health/* /docs*
  handle @api {
    reverse_proxy api:4000
  }

  handle {
    reverse_proxy web:3000
  }

  header {
    X-Content-Type-Options nosniff
    X-Frame-Options DENY
    Referrer-Policy no-referrer
    Permissions-Policy camera=(), microphone=(), geolocation=()
  }
}
